# 本地开发：./scripts/dev-db.sh up 起的 MySQL
NODE_ENV=development
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=erp3d
DB_PASSWORD=
DB_NAME=erp3d
# 连接池上限（lustone 共享库要求 ERP 总连接 ≤30，默认 20）
DB_POOL_MAX=20
DB_TIMEZONE=+08:00
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=7d
FILES_DIR=./files
# 后台任务（超时提醒、outbox）只在一个节点开
ENABLE_JOBS=false
# 雪花 id 工作节点号 0-31（多实例时各不相同）
WORKER_ID=1
