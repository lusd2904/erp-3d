# 本地开发：./scripts/dev-db.sh up 起的 MySQL
NODE_ENV=development
PORT=8080
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=erp3d
DB_PASSWORD=erp3d_dev_pwd
DB_NAME=erp3d
# 连接池上限（lustone 共享库要求 ERP 总连接 ≤30，三台 × 9 = 27 ≤ 30；交接时两台在线也不超，钳制 1..10，默认 9）
DB_POOL_MAX=9
DB_TIMEZONE=+08:00
# 节点名称（缺省取 os.hostname()）
NODE_NAME=

JWT_SECRET=change-me-in-prod-please-32chars-min
JWT_REFRESH_SECRET=change-me-refresh-secret-32chars-min
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=7d
FILES_DIR=./files

# 附件存储：local 或 s3
ATTACH_STORAGE=local
# S3 / MinIO 生产凭据见 lustone /home/opc/private/erp3d-minio.txt，部署时注入环境变量；不要写进仓库
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=
S3_PREFIX=

# 后台任务：可多台同时开，定时任务靠 MySQL 锁保证同一时刻只有一台执行
ENABLE_JOBS=false
# 雪花 id 工作节点号 0-31（三台必须不同，如 ib-v6=6、ib-v7=7、ib-v8=8）
WORKER_ID=1
